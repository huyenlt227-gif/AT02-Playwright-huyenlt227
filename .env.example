# =============================================================================
# AutoPath AI - Environment Configuration
#
# Copy this file to .env and fill in real values.
# Never commit .env - it may contain sensitive session/account information.
# =============================================================================

# Base URL of the e-commerce website (User / customer side)
USER_BASE_URL=https://cms.anhtester.com

# Base URL of the Admin login page
ADMIN_BASE_URL=https://cms.anhtester.com/login

# Customer account used by tests that need an authenticated user session
CUSTOMER_EMAIL=customer@example.com
CUSTOMER_PASSWORD=123456

# Admin account used by admin verification tests
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=123456

# Global timeout (ms) applied to Playwright actions and expectations
DEFAULT_TIMEOUT=30000

# Number of parallel workers. Set to 1 on CI.
WORKERS=2